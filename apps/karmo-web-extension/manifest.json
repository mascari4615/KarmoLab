{
  "manifest_version": 3,
  "name": "KarmoWebExtension",
  "short_name": "Karmo",
  "version": "0.7.0",
  "description": "방송, 시청 페이지와 로컬 앱 연결. 즐겨찾기 정리. 유튜브 시청 기록과 팔로우 목록 수집.",
  "permissions": [
    "storage",
    "bookmarks",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://*.chzzk.naver.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.sooplive.com/*",
    "https://*.sooplive.com/*",
    "https://www.sooplive.co.kr/*",
    "https://*.sooplive.co.kr/*",
    "https://api.chzzk.naver.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://*.chzzk.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KarmoWebExtension",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://mascari4615.github.io/*",
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
