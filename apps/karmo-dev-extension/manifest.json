{
  "manifest_version": 3,
  "name": "KarmoDevExtension",
  "short_name": "KarmoDev",
  "version": "0.14.0",
  "key": "",
  "description": "방송, 시청 페이지와 로컬 앱 연결. 즐겨찾기 정리. 유튜브, 치지직, SOOP, X 수집과 하루 한 번 내보내기.",
  "permissions": [
    "storage",
    "bookmarks",
    "scripting",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://*.chzzk.naver.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.sooplive.com/*",
    "https://*.sooplive.com/*",
    "https://www.sooplive.co.kr/*",
    "https://*.sooplive.co.kr/*",
    "https://api.chzzk.naver.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://music.youtube.com/*",
    "https://console.cloud.google.com/*",
    "https://dash.mascari4615.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://*.chzzk.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "x-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "yt-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "KarmoDevExtension",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
