{
  "manifest_version": 3,
  "name": "KarmoDevExtension",
  "short_name": "KarmoDev",
  "version": "0.29.1",
  "key": "",
  "description": "獄쎻뫗?? ??뽮퍕 ??륁뵠筌왖?? 嚥≪뮇類????怨뚭퍙. 筌앸Þ爰쇽㎕?섎┛ ?類ｂ봺. ?醫뤿뮔?? 燁살꼷?筌? SOOP, X ??륁춿????롳펷 ??甕??????용┛.",
  "permissions": [
    "storage",
    "bookmarks",
    "scripting",
    "tabs",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*",
    "https://*.chzzk.naver.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://www.sooplive.com/*",
    "https://*.sooplive.com/*",
    "https://www.sooplive.co.kr/*",
    "https://*.sooplive.co.kr/*",
    "https://api.chzzk.naver.com/*",
    "https://x.com/*",
    "https://*.x.com/*",
    "https://twitter.com/*",
    "https://music.youtube.com/*",
    "https://console.cloud.google.com/*",
    "https://dash.mascari4615.com/*",
    "https://pinterest.com/*",
    "https://*.pinterest.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/*",
        "https://*.chzzk.naver.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://*.x.com/*"
      ],
      "js": [
        "x-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://music.youtube.com/*"
      ],
      "js": [
        "yt-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://arca.live/*"
      ],
      "js": [
        "block-defaults.js",
        "block-toast.js",
        "block-core.js",
        "arca-insight.js",
        "arca-block.js",
        "arca-seen.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "KarmoDevExtension",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "http://127.0.0.1/*",
      "http://localhost/*"
    ]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
