{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karmo Launcher Setup",
  "version": "0.1.0",
  "identifier": "com.mascari4615.launcher.setup",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Karmo Launcher 설치",
        "width": 760,
        "height": 440,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../src-tauri/icons/32x32.png", "../../src-tauri/icons/icon.ico"]
  }
}
