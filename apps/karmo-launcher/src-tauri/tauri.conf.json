{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karmo Launcher",
  "version": "0.1.20",
  "identifier": "com.mascari4615.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Karmo Launcher",
        "width": 1200,
        "height": 740,
        "minWidth": 640,
        "minHeight": 400,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdCNERFQUE2MzRGNTVEQ0IKUldUTFhmVTBwdXBOZXdJMk1RODMyVEw0YjdvYjJZK3ovTzZRWUNlaUM2N2EvNlJxRzZmbkhuSmMK",
      "endpoints": [
        "https://github.com/mascari4615/KarmoLab/releases/download/launcher-updater/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
