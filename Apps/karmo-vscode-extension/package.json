{
	"name": "karmo-vscode-extension",
	"displayName": "KarmoVSC-Ext",
	"publisher": "mascari4615",
	"version": "0.0.1",
	"description": "VS Code 프로젝트 탐색기 파일/폴더 토글 확장 프로그램 (KarmoVSC-Ext)",
	"engines": {
		"vscode": "^1.90.0"
	},
	"icon": "resources/star-transparent-B-128.png",
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "karmo.toggleGroup",
				"title": "Karmo: Toggle Group"
			},
			{
				"command": "karmo.toggleAllOff",
				"title": "Karmo: Toggle All Off"
			},
			{
				"command": "karmo.toggleAllOn",
				"title": "Karmo: Toggle All On"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "karmo-sidebar-container",
					"title": "KarmoLab",
					"icon": "resources/sidebar-icon.svg"
				}
			]
		},
		"views": {
			"karmo-sidebar-container": [
				{
					"type": "webview",
					"id": "karmo-sidebar-view",
					"name": "Karmo Explorer",
					"icon": "resources/sidebar-icon.svg"
				}
			]
		},
		"configuration": {
			"title": "KarmoVSC-Ext",
			"properties": {
				"karmo.toggleGroups": {
					"type": "array",
					"description": "Toggle groups configuration for KarmoVSC-Ext. You can add your own groups here.",
					"default": [
						{
							"id": "unity-meta",
							"name": "Unity Meta Files",
							"patterns": [
								"**/*.meta"
							]
						},
						{
							"id": "unity-folders",
							"name": "Unity Folders",
							"patterns": [
								"**/Library",
								"**/Logs",
								"**/Temp",
								"**/UserSettings"
							]
						},
						{
							"id": "dotnet-projects",
							"name": "C# Projects",
							"patterns": [
								"**/*.csproj",
								"**/*.sln",
								"**/bin",
								"**/obj"
							]
						},
						{
							"id": "git-data",
							"name": "Git Data",
							"patterns": [
								"**/.git",
								"**/.gitignore"
							]
						}
					],
					"items": {
						"type": "object",
						"properties": {
							"id": {
								"type": "string"
							},
							"name": {
								"type": "string"
							},
							"patterns": {
								"type": "array",
								"items": {
									"type": "string"
								}
							}
						}
					}
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/vscode": "^1.90.0",
		"@types/node": "20.x",
		"typescript": "^5.4.5",
		"eslint": "^8.57.0",
		"@typescript-eslint/parser": "^7.11.0",
		"@typescript-eslint/eslint-plugin": "^7.11.0"
	},
	"buildTime": "2026-01-18 14:02:14"
}