<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#E1E1E1</Color>
    <Color x:Key="SecondaryTextColor">#AAAAAA</Color>
    <Color x:Key="MutedTextColor">#666666</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#00A2FF</Color> <!-- Vibrant Blue -->
    <Color x:Key="DeleteColor">#FF4D4D</Color>
    <Color x:Key="HeroGradientStartColor">#44ff8c00</Color> <!-- Semi-transparent Orange -->


    <!-- Theme Colors (Obsidian Ember - Volcanic Orange) -->
    <Color x:Key="WindowBackgroundColor">#121212</Color> <!-- Charcoal Black -->
    <Color x:Key="SidebarBackgroundColor">#1a1a1a</Color> <!-- Obsidian Stone -->
    <Color x:Key="CardBackgroundColor">#242424</Color>   <!-- Dark Ash -->
    <Color x:Key="BorderColor">#333333</Color>           <!-- Graphite -->
    <Color x:Key="LoggerBackgroundColor">#000000</Color> <!-- Pitch Black -->

    <!-- Brushes -->
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="LoggerBackgroundBrush" Color="{StaticResource LoggerBackgroundColor}"/>
    
    <!-- Glassmorphism Tokens (Warm Glow) -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#D91a1a1a"/> 
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#66ff8c00"/>     <!-- Orange Ember Glow -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2121212"/> 

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#fff5e6"/>       <!-- Warm White -->
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#b3a296"/>     <!-- Ash Grey -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#7a6b61"/>         <!-- Burnt Dust -->
    
    <!-- Accents & Actions -->
    <SolidColorBrush x:Key="AccentBrush" Color="#ff8c00"/>            <!-- Burnt Orange -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#ffaa33"/>       <!-- Bright Ember Hover -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DeleteBrush" Color="{StaticResource DeleteColor}"/>

</ResourceDictionary>
