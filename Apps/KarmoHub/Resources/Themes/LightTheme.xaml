<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Neutral Colors -->
    <Color x:Key="WindowBackgroundColor">#F5F5F5</Color>
    <Color x:Key="SidebarBackgroundColor">#252526</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="BorderColor">#DDDDDD</Color>
    <Color x:Key="LoggerBackgroundColor">#F0F0F0</Color>
    
    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#000000</Color>
    <Color x:Key="SecondaryTextColor">#444444</Color>
    <Color x:Key="MutedTextColor">#888888</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#007ACC</Color>
    <Color x:Key="DeleteColor">#F44336</Color>
    <Color x:Key="HeroGradientStartColor">#44007ACC</Color> <!-- Semi-transparent Blue -->

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FDFDFF"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#F5F5FA"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="LoggerBackgroundBrush" Color="#F0F0F5"/>
    
    <!-- Glassmorphism Tokens -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#CCF5F5FA"/> <!-- Semi-transparent -->
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#33000000"/> <!-- Subtle shadow-like line -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#EEFDFDFF"/>

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#505060"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#9090A0"/>

    <!-- Accents & Actions -->
    <SolidColorBrush x:Key="AccentBrush" Color="#007ACC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#0090F0"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCDCE5"/>
    <SolidColorBrush x:Key="DeleteBrush" Color="#FF453A"/>

</ResourceDictionary>
