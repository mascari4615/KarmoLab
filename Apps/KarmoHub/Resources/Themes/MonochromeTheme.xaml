<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <!-- Text Colors -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#BBBBBB</Color>
    <Color x:Key="MutedTextColor">#666666</Color>
    
    <!-- Accent Colors -->
    <Color x:Key="AccentColor">#FFFFFF</Color> <!-- Pure White -->
    <Color x:Key="DeleteColor">#FF4D4D</Color>
    <Color x:Key="HeroGradientStartColor">#44FFFFFF</Color> <!-- Semi-transparent White -->

    <!-- Theme Colors (Monochrome - Black & White) -->
    <Color x:Key="WindowBackgroundColor">#000000</Color> <!-- Pure Black -->
    <Color x:Key="SidebarBackgroundColor">#0a0a0a</Color> <!-- Very Dark Gray -->
    <Color x:Key="CardBackgroundColor">#141414</Color>   <!-- Dark Gray -->
    <Color x:Key="BorderColor">#333333</Color>           <!-- Mid Gray -->
    <Color x:Key="LoggerBackgroundColor">#050505</Color> <!-- Near Black -->

    <!-- Brushes -->
    <!-- Backgrounds -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="LoggerBackgroundBrush" Color="{StaticResource LoggerBackgroundColor}"/>
    
    <!-- Glassmorphism Tokens (Grayscale) -->
    <SolidColorBrush x:Key="GlassBackgroundBrush" Color="#D90a0a0a"/> 
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#66FFFFFF"/>     <!-- White Shine -->
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#F2000000"/> 

    <!-- Text -->
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#ffffff"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#cccccc"/>     <!-- Light Gray -->
    <SolidColorBrush x:Key="MutedTextBrush" Color="#808080"/>         <!-- Medium Gray -->
    
    <!-- Accents & Actions -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFFFF"/>            <!-- White Accent -->
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#DDDDDD"/>       <!-- Slightly Darker White Hover -->
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="DeleteBrush" Color="{StaticResource DeleteColor}"/>

</ResourceDictionary>
