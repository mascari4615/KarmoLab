<Window x:Class="KarmoHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KarmoHub"
        mc:Ignorable="d"
        Title="KarmoHub" Height="600" Width="900"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="#252526" Grid.Column="0">
            <StackPanel Margin="0">
                <TextBlock Text="KarmoHub" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,30,20,40" HorizontalAlignment="Left"/>
                
                <RadioButton Content="라이브러리" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,10" IsChecked="True" Style="{StaticResource {x:Type ToggleButton}}"/>
                <RadioButton Content="설치" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,10" Style="{StaticResource {x:Type ToggleButton}}"/>
                <RadioButton Content="커뮤니티" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="20,10" Style="{StaticResource {x:Type ToggleButton}}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Margin="30,20,30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="내 라이브러리" FontSize="28" FontWeight="Light" Margin="0,0,0,20"/>

            <ListBox x:Name="GameInfos" Grid.Row="1" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" Width="260" Height="320" Margin="0,0,20,20" CornerRadius="4">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.1" Direction="270"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/> 
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Placeholder Thumbnail -->
                                <Border Background="#EEEEEE" CornerRadius="4,4,0,0">
                                    <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="40" FontWeight="Bold" Opacity="0.3"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="15">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding AppType}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#444444" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="15,0,15,15">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="v" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                    
                                    <Button Content="실행" Width="80" Height="30" HorizontalAlignment="Right" 
                                            Background="#007ACC" Foreground="White" BorderThickness="0"
                                            Click="OnPlayButtonClick">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="4"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Status Bar -->
            <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,10,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="준비됨" VerticalAlignment="Center" Foreground="#555555"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                       <Button Content="현재 실행 중인 게임 강제 종료" Padding="10,5" Margin="0,0,10,0" Click="OnStopGame" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1"/>
                       <Button Content="숨기기" Padding="10,5" Click="OnHide" Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
