<Window
    x:Class="KarmoHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:KarmoHub"
    xmlns:tb="using:H.NotifyIcon"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:KarmoHub.Models"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt"/>
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <!-- TaskbarIcon initialized in code-behind to avoid XamlCompiler issues -->
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Custom Title Bar -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Height="32" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/> <!-- Icon/Text -->
                <ColumnDefinition Width="*"/>    <!-- Drag Region -->
            </Grid.ColumnDefinitions>
            <TextBlock Text="KarmoHub" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="12" Foreground="#AAAAAA"/>
        </Grid>

        <!-- Sidebar (Spans all rows to be behind titlebar if needed, or start below) -->
        <!-- We want sidebar to look integrated with Mica. Use semi-transparent background to let Mica show through -->
        <Border Grid.Row="1" Grid.Column="0" Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,10,0,0">
                <!-- <TextBlock Text="KarmoHub" Foreground="White" FontSize="22" FontWeight="Bold" Margin="20,10,20,30" HorizontalAlignment="Left"/> -->
                
                <RadioButton Content="라이브러리" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" IsChecked="True" />
                <RadioButton Content="설치" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" />
                <RadioButton Content="커뮤니티" FontSize="14" Height="40" Background="Transparent" Foreground="White" BorderThickness="0" Padding="10,0" />
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Grid.Column="1" Padding="30,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="120" /> <!-- Log Area -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="내 라이브러리" FontSize="28" FontWeight="Light" Margin="0,0,0,20"/>
            </StackPanel>

            <!-- Game List (GridView for Card Layout) -->
            <GridView x:Name="GameInfos" Grid.Row="1" SelectionMode="None">
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameItem">
                        <Border Background="White" Width="260" Height="320" CornerRadius="4" BorderBrush="#EEEEEE" BorderThickness="1" Margin="0,0,20,20">
                             <!-- Shadow effect not directly supported on Border in WinUI 3 same as WPF, using ThemeShadow on parent or alternative if needed, skipping for now -->
                             <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="160"/> 
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Placeholder Thumbnail -->
                                <Border Background="#EEEEEE" CornerRadius="4,4,0,0">
                                    <TextBlock Text="{x:Bind Name}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#CCCCCC" FontSize="40" FontWeight="Bold" Opacity="0.3"/>
                                </Border>

                                <StackPanel Grid.Row="1" Margin="15">
                                    <TextBlock Text="{x:Bind Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind Id}" FontSize="12" Foreground="Gray" Margin="0,2,0,0"/> <!-- AppType substitute -->
                                    <TextBlock Text="{x:Bind Description}" FontSize="13" Foreground="#444444" TextWrapping="Wrap" Margin="0,10,0,0" MaxHeight="60" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <Grid Grid.Row="2" Margin="15,0,15,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="v" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{x:Bind DefaultVersion}" FontSize="12" Foreground="Gray"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="5">
                                        <Button Width="30" Height="30" Padding="0" Background="#EEEEEE" BorderThickness="0" ToolTipService.ToolTip="설치 폴더 열기" Click="OnOpenFolderClick">
                                            <FontIcon Glyph="&#xED25;" FontSize="12" Foreground="#333333"/>
                                        </Button>
                                        <!-- Primary Action Button (Install/Play) -->
                                        <Button Content="{x:Bind ActionButtonText}" 
                                                Height="30" 
                                                Padding="10,0"
                                                Click="OnPlayButtonClick"
                                                Background="{ThemeResource SystemControlHighlightAccentBrush}" 
                                                Foreground="White"
                                                BorderThickness="0"
                                                FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

             <!-- Log Console -->
            <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="0" Margin="0,10,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Log Console" Foreground="#AAAAAA" FontSize="12" Margin="10,5"/>
                    <ListBox x:Name="LogListBox" Grid.Row="1" Background="Transparent" Foreground="#CCCCCC" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <Border Grid.Row="3" Background="#FFFFFF" Padding="15,10" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="준비됨" Foreground="#666"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                        <Button Content="중지" Click="OnStopGame"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
