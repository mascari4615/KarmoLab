.tool-container {
	flex-grow: 1;
	background-color: rgb(17, 24, 39); /* gray-900 */
	padding: 20px;
	color: rgb(229, 231, 235); /* gray-200 */
}

.tool-header {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-color: rgb(55, 65, 81);
	padding-bottom: 15px;
	margin-bottom: 20px;
}

.header-title {
	font-size: 20px;
	-unity-font-style: bold;
	color: white;
}

.tool-selector {
	width: 200px;
}

.tool-body {
	flex-grow: 1;
}

.input-group {
	margin-bottom: 15px;
}

.input-label {
	color: rgb(156, 163, 175); /* gray-400 */
	font-size: 12px;
	margin-bottom: 5px;
}

.input-field > .unity-text-field__input {
	background-color: rgb(31, 41, 55); /* gray-800 */
	border-color: rgb(75, 85, 99); /* gray-600 */
	color: white;
	height: 80px;
	-unity-text-align: upper-left;
	border-radius: 4px;
}

.input-field-single > .unity-text-field__input {
	background-color: rgb(31, 41, 55);
	border-color: rgb(75, 85, 99);
	color: white;
	border-radius: 4px;
}

.section-title {
	font-size: 14px;
	-unity-font-style: bold;
	color: white;
	margin-top: 10px;
	margin-bottom: 10px;
	border-bottom-width: 1px;
	border-bottom-color: rgb(55, 65, 81);
	padding-bottom: 5px;
}

.actions-grid {
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 20px;
}

.action-btn {
	width: 48%;
	margin-right: 2%;
	margin-bottom: 10px;
	background-color: rgb(79, 70, 229); /* indigo-600 */
	color: white;
	-unity-font-style: bold;
	padding: 10px;
	border-radius: 6px;
	border-width: 0;
}

.action-btn:hover {
	background-color: rgb(67, 56, 202); /* indigo-700 */
}

/* 
.action-btn:nth-child(2n) {
	margin-right: 0;
} 
*/

.output-group {
	margin-top: 10px;
}

.output-field > .unity-text-field__input {
	background-color: rgb(17, 24, 39); /* 더 어둡게 */
	border-color: rgb(75, 85, 99);
	color: rgb(165, 180, 252); /* indigo-300 */
	height: 100px;
	-unity-text-align: upper-left;
}

.copy-btn {
	margin-top: 5px;
	align-self: flex-end;
	background-color: rgb(55, 65, 81);
	color: white;
	width: 150px;
	border-radius: 4px;
}
