<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
	<Style src="ToolStyle.uss" />
	<ui:VisualElement class="tool-container bg-gray-900">
		
		<!-- 헤더 -->
		<ui:VisualElement class="tool-header">
			<ui:Label name="ToolTitle" text="Tool Name" class="header-title" />
			<ui:DropdownField name="ToolSelector" class="tool-selector" />
		</ui:VisualElement>

		<!-- 입력 -->
		<ui:ScrollView class="tool-body">
			<ui:VisualElement class="input-group">
				<ui:Label text="Main Input" class="input-label" />
				<ui:TextField name="InputMain" multiline="true" class="input-field" />
			</ui:VisualElement>

			<ui:VisualElement class="input-group">
				<ui:Label text="Sub Input (Optional)" class="input-label" />
				<ui:TextField name="InputSub" class="input-field-single" />
			</ui:VisualElement>

			<!-- 동작 버튼 그리드 -->
			<ui:Label text="Actions" class="section-title" />
			<ui:VisualElement name="ActionButtonsContainer" class="actions-grid" />
			
			<!-- 출력 -->
			<ui:VisualElement class="output-group">
				<ui:Label text="Output / Log" class="input-label" />
				<ui:TextField name="OutputField" multiline="true" readonly="true" class="output-field" />
				<ui:Button name="BtnCopyOutput" text="Copy to Clipboard" class="copy-btn" />
			</ui:VisualElement>
		</ui:ScrollView>

	</ui:VisualElement>
</ui:UXML>
