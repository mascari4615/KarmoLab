@import url("ThemeTokens.uss");

.time-block-compact {
	font-size: 8px;
	color: var(--block-text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
	padding: 0 1px;
}
.time-block-compact-bg {
	background-color: rgba(0, 0, 0, 0);
}
.time-block-row {
	flex-direction: row;
	align-items: center;
	padding: 0 4px; /* 좌우 여백 조금 더 확보 */
	overflow: hidden;
}

.time-block-row .time-block-title {
	font-size: 11px; /* 가독성 위해 1px 키움 */
	margin-right: 4px;
	flex-shrink: 1; 
	margin-bottom: 0;
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.time-block-row .time-block-time {
	font-size: 10px;
	opacity: 0.9;
	flex-shrink: 0;
	margin-bottom: 0;
	white-space: nowrap;
}

.time-block-compact-bg {
	background-color: transparent;
}

.planner-container {
	flex-grow: 1;
	background-color: var(--color-bg-base);
	padding: 15px;
	color: var(--color-text-main);
}

/* 컨테이너 내부의 모든 텍스트 요소에 폰트 강제 적용 */
.planner-container Label,
.planner-container Button,
.planner-container TextField,
.planner-container .unity-text-element {
	-unity-font: url("project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf");
	-unity-font-definition: initial;
}

/* 유니티 기본 테마의 TextField 가시성 수정 */
.unity-text-field,
.unity-base-text-field,
.unity-text-field__input {
	--unity-cursor-color: var(--unity-cursor-color);
}

.planner-container .unity-text-field__input {
	background-color: var(--color-bg-base); /* 고대비를 위해 표면색을 기본색으로 변경 */
	color: var(--color-text-main);
	border-color: var(--color-border);
	border-width: 1px;
	border-radius: 4px;
}

.unity-text-field__input:focus {
	border-color: var(--color-border-focus);
}

/* DropdownField/EnumField 가시성 수정 */
.planner-container .unity-base-popup-field__input {
	background-color: var(--color-bg-surface);
	color: var(--color-text-main);
	border-color: var(--color-border);
	border-width: 1px;
	border-radius: 4px;
}

.planner-container .unity-base-popup-field__text {
	color: var(--color-text-main);
}

.planner-container .unity-base-popup-field__arrow {
	-unity-background-image-tint-color: var(--color-text-main);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__input {
	background-color: var(--color-primary-hover);
	border-color: var(--color-primary-hover);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__text {
	color: var(--color-primary-text-hover);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__arrow {
	-unity-background-image-tint-color: var(--color-primary-text-hover);
}

/* 확장된 드롭다운 목록 (팝업) 스타일링 */
.unity-base-dropdown__container-outer {
	background-color: var(--color-bg-surface);
	border-color: var(--color-border);
	border-width: 1px;
}

.unity-base-dropdown__item {
	background-color: var(--color-bg-surface);
}

.unity-base-dropdown__label {
	color: var(--color-text-main);
	-unity-font: url("project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf");
	-unity-font-definition: initial;
	font-size: 14px;
}

/* 특정 아이템 상태 */
.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:checked,
.unity-base-dropdown__item:selected {
	background-color: var(--color-bg-hover);
	color: var(--color-text-main);
}

/* 드롭다운의 스크롤바 */
.unity-scroller__high-button,
.unity-scroller__low-button,
.unity-scroller__slider {
	background-color: var(--color-bg-base);
	border-color: var(--color-border);
}

/* 드롭다운에서 원치 않는 가로 스크롤바가 나타날 경우 숨기거나 최소화 */
.unity-scroller--horizontal {
	display: none; 
	height: 0;
}

.unity-base-slider__dragger {
	background-color: var(--color-border);
}

/* --- 헤더 --- */
.top-header {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 10px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	margin-bottom: 15px;
	flex-shrink: 0; /* 내용이 확장될 때 줄어들지 않도록 방지 */
}

.header-left {
	flex-direction: row;
	align-items: center;
}

.header-icon {
	background-color: var(--color-primary); 
	padding: 8px;
	border-radius: 8px;
	margin-right: 12px;
	-unity-font-style: bold;
	color: var(--color-primary-text);
}

.header-title {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-text-main);
}

.header-subtitle {
	font-size: 12px;
	color: var(--color-text-sub);
}

.header-right {
	align-items: flex-end;
}

.theme-toggle-btn {
	width: 30px;
	height: 30px;
	background-color: transparent;
	color: var(--color-text-sub);
	border-width: 0;
	font-size: 20px;
	margin-bottom: 5px;
}
.theme-toggle-btn:hover {
	color: var(--color-text-main);
}

.header-subtitle-input > .unity-text-field__input {
	background-color: transparent;
	border-color: transparent;
	color: var(--color-text-sub);
	font-size: 14px;
	padding: 0;
	margin: 0;
}

.header-subtitle-input:hover > .unity-text-field__input {
	background-color: var(--color-bg-hover);
}

.header-date {
	font-size: 14px;
	-unity-font-style: bold;
	color: var(--color-text-sub);
}

.header-dday {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-primary); 
}

/* --- Tabs --- */
.nav-tabs {
	flex-direction: row;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	margin-bottom: 20px;
	flex-shrink: 0; /* Prevent shrinking */
}

.tab-content {
	flex-grow: 1;
}

.tab-button {
	background-color: transparent;
	border-width: 0;
	color: var(--color-text-sub);
	padding: 10px 15px;
	-unity-font-style: bold;
	font-size: 14px;
	border-bottom-width: 2px;
	border-bottom-color: transparent;
	margin-right: 5px;
}

.tab-button:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
	border-radius: 4px 4px 0 0;
}

.tab-button.selected {
	color: var(--color-primary-text);
	background-color: var(--color-primary);
	border-bottom-color: var(--color-primary);
	border-radius: 4px 4px 0 0;
}

.tab-button.selected:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

/* --- 대시보드 --- */
.advice-banner {
	background-color: var(--color-bg-surface);
	padding: 15px;
	border-radius: 8px;
	border-width: 1px;
	border-color: var(--color-border);
	margin-bottom: 20px;
}

.advice-text {
	color: var(--color-text-main);
	-unity-font-style: italic;
	white-space: normal;
}

.stats-grid {
	flex-direction: row;
	justify-content: space-between;
	margin-bottom: 20px;
}

.stat-card {
	flex-grow: 1;
	background-color: var(--color-bg-surface);
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 8px;
	padding: 15px;
	margin-right: 10px;
}

.stat-title {
	font-size: 12px;
	color: var(--color-text-sub);
	-unity-font-style: bold;
	margin-bottom: 5px;
}

.stat-value {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-text-main);
}

.bg-blue .stat-title { color: var(--color-text-sub); }
.bg-purple .stat-title { color: var(--color-text-sub); }
.bg-green .stat-title { color: var(--color-text-sub); }

.dashboard-row {
	flex-direction: row;
}

.dashboard-col {
	flex-grow: 1;
	background-color: var(--color-bg-surface);
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 8px;
	padding: 20px;
	margin-right: 10px;
	height: 300px;
}

.section-title {
	font-size: 16px;
	-unity-font-style: bold;
	color: var(--color-text-main);
	margin-bottom: 15px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	padding-bottom: 5px;
}

.progress-label {
	font-size: 12px;
	color: var(--color-text-sub);
	margin-bottom: 2px;
	margin-top: 10px;
}

.status-bar .unity-progress-bar__container {
	height: 10px;
	min-height: 10px;
}

.status-bar .unity-progress-bar__background {
	background-color: var(--color-bg-hover);
	border-radius: 5px;
	border-width: 0;
}

.status-bar .unity-progress-bar__progress {
	border-radius: 5px;
	margin: 0;
}

.status-bar.red .unity-progress-bar__progress { background-color: var(--color-text-main); }
.status-bar.blue .unity-progress-bar__progress { background-color: var(--color-text-main); }
.status-bar.yellow .unity-progress-bar__progress { background-color: var(--color-text-main); }

.memo-input {
	flex-grow: 1;
	white-space: normal;
}

.memo-input > .unity-text-field__input {
	background-color: var(--color-bg-base);
	border-color: var(--color-border);
	color: var(--color-text-main);
	-unity-text-align: upper-left;
}

.save-btn {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 6px;
	padding: 8px 16px;
	border-width: 0;
	-unity-font-style: bold;
	margin-top: 10px;
	align-self: flex-end;
}

.save-btn:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

/* --- 퀘스트 보드 (할 일) --- */
.task-columns {
	flex-direction: row;
	height: 600px;
}

.task-column {
	flex-grow: 1;
	width: 33%;
	background-color: var(--color-bg-surface);
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 8px;
	margin-right: 15px;
	display: flex;
	flex-direction: column;
}

.col-header {
	padding: 15px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	-unity-font-style: bold;
	font-size: 14px;
}

.text-purple { color: var(--color-text-main); background-color: transparent; }
.text-blue { color: var(--color-text-main); background-color: transparent; }
.text-green { color: var(--color-text-main); background-color: transparent; }

.task-list-scroll {
	flex-grow: 1;
	padding: 10px;
}

.col-footer {
	padding: 10px;
	border-top-width: 1px;
	border-top-color: var(--color-border);
	flex-direction: row;
}

.task-input {
	flex-grow: 1;
	margin-right: 5px;
}

.task-add-btn {
	width: 30px;
	background-color: var(--color-bg-hover);
	color: var(--color-text-hover);
	-unity-font-style: bold;
	border-width: 0;
}

.task-add-btn:hover {
	background-color: var(--color-text-main);
	color: var(--color-bg-base);
}

.todo-item {
	flex-direction: row;
	padding: 8px;
	border-radius: 4px;
	margin-bottom: 5px;
	background-color: transparent;
}

.todo-item:hover {
	background-color: var(--color-bg-hover);
}

.todo-toggle {
	width: 16px;
	height: 16px;
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 4px;
	margin-right: 8px;
	margin-top: 2px;
	background-color: transparent;
}

.todo-toggle.completed {
	background-color: var(--color-text-main);
	border-color: var(--color-text-main);
}

.todo-content {
	flex-grow: 1;
	font-size: 14px;
	color: var(--color-text-main);
	white-space: normal;
}

.todo-content.completed {
	color: var(--color-text-sub);
	opacity: 0.6;
}

.todo-delete {
	color: var(--color-text-sub);
	background-color: transparent;
	border-width: 0;
	width: 20px;
	opacity: 0;
}

.todo-item:hover .todo-delete {
	opacity: 1;
}

/* --- 일정표 (기존 로직) --- */
.schedule-scroll {
	flex-grow: 1;
	background-color: var(--color-bg-surface);
}

.time-ruler-container {
	height: 1440px; 
	flex-direction: row; /* 열 배치를 위해 가로 방향으로 변경 */
}

.time-axis {
	width: 60px;
	border-right-width: 1px;
	border-right-color: var(--color-border);
	background-color: var(--color-bg-base);
}

.day-column {
	flex-grow: 1;
	height: 100%;
	border-right-width: 1px;
	border-right-color: var(--color-border);
	position: relative;
}

.day-header {
	height: 30px;
	background-color: var(--color-bg-surface);
	-unity-text-align: middle-center;
	font-size: 12px;
	-unity-font-style: bold;
	color: var(--color-text-sub);
	position: absolute;
	top: 0; left: 0; right: 0;
}

.hour-line {
	position: absolute;
	left: 0; 
	right: 0; 
	height: 1px; 
	background-color: var(--color-border); /* 부드러운 선 */
}

.hour-label {
	position: absolute;
	top: -10px;
	right: 5px; /* 축 내부 우측 정렬 */
	font-size: 10px;
	color: var(--color-text-sub);
}

.time-block {
	position: absolute;
	left: 0; 
	right: 1px; /* 테두리를 위한 간격 */
	border-radius: 4px;
	padding: 2px 5px;
	overflow: hidden;
	font-size: 10px;
	margin-left: 2px;
	margin-right: 2px;
	color: var(--block-text);
}

/* 현재 시간 표시 바 */
.current-time-indicator {
	position: absolute;
	left: 60px; /* time-axis 너비만큼 오프셋 */
	right: 0;
	background-color: var(--color-time-indicator);
	height: var(--height-time-indicator);
}

/* 확장된 색상 팔레트 (모던 파스텔) */
.block-color-0 { background-color: var(--block-color-0); }
.block-color-1 { background-color: var(--block-color-1); }
.block-color-2 { background-color: var(--block-color-2); }
.block-color-3 { background-color: var(--block-color-3); }
.block-color-4 { background-color: var(--block-color-4); }
.block-color-5 { background-color: var(--block-color-5); }
.block-color-6 { background-color: var(--block-color-6); }
.block-color-7 { background-color: var(--block-color-7); }
.block-color-8 { background-color: var(--block-color-5); } /* 재사용 */
.block-color-9 { background-color: var(--block-color-6); } /* 재사용 */
.block-color-10 { background-color: var(--block-color-7); } /* 재사용 */
.block-color-11 { background-color: var(--block-color-4); } /* 재사용 */

.date-nav {
	flex-direction: row;
	justify-content: center;
	align-items: center;
	margin-bottom: 15px;
}

.nav-button {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 4px;
	border-width: 0;
	-unity-font-style: bold;
}

.nav-button:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.date-label {
	font-size: 16px;
	-unity-font-style: bold;
	color: var(--color-text-main);
	width: 200px;
	-unity-text-align: middle-center;
}

.schedule-input-row {
	flex-direction: row;
	align-items: center;
	margin-bottom: 10px;
	background-color: var(--color-bg-surface);
	padding: 8px;
	border-radius: 8px;
}

.block-input-title { flex-grow: 1; }
.block-input-time { width: 40px; }

/* --- 비밀 노트 --- */
.secret-header-box {
	background-color: var(--color-bg-surface);
	border-width: 1px;
	border-color: var(--color-border);
	padding: 15px;
	border-radius: 8px;
	margin-bottom: 20px;
}

.secret-title {
	color: var(--color-text-main);
	-unity-font-style: bold;
	margin-bottom: 5px;
}

.secret-desc {
	color: var(--color-text-sub);
	font-size: 12px;
}

.secret-form {
	background-color: var(--color-bg-surface);
	padding: 20px;
	border-radius: 8px;
	border-width: 1px;
	border-color: var(--color-border);
	margin-bottom: 20px;
}

.secret-btn {
	margin-top: 10px;
	background-color: var(--color-bg-hover);
	color: var(--color-text-hover);
	padding: 10px;
	-unity-font-style: bold;
	border-width: 0;
}

.secret-btn:hover {
	background-color: var(--color-text-main);
	color: var(--color-bg-base);
}

.secret-item {
	background-color: var(--color-bg-surface);
	padding: 15px;
	margin-bottom: 10px;
	border-radius: 8px;
	border-width: 1px;
	border-color: var(--color-border);
}

.secret-item:hover {
	border-color: var(--color-text-main);
}

/* --- 오버레이 & 팝업 --- */

/* 입력 필드 대비 수정 */
.unity-base-field__label {
	color: var(--color-text-sub); 
}

/* IntegerField 등이 흰 배경에 흰 글씨로 나오는 문제 수정 */
.unity-integer-field .unity-integer-field__input,
.unity-double-field .unity-double-field__input,
.unity-text-field .unity-text-field__input {
	background-color: var(--color-bg-base); 
	color: var(--color-text-main);
	border-color: var(--color-border);
}

/* 타임 블록 내부 레이아웃 */
.time-block-time {
	font-size: 9px;
	color: var(--block-text); /* 블록 텍스트 설정에서 파생된 고대비 색상 사용 */
	opacity: 0.8;
	margin-bottom: 2px;
}

.time-block-title {
	font-size: 11px;
	-unity-font-style: bold;
	color: var(--block-text);
	white-space: nowrap;
	overflow: hidden;
	text-overflow: ellipsis;
}

.day-toggle {
    margin-right: 2px;
    margin-left: 2px;
}
.day-toggle .unity-toggle__label {
    min-width: 10px;
    font-size: 10px;
    color: rgb(200, 200, 200);
}

.time-block-btn {
	position: absolute;
	top: 2px;
	right: 2px;
	width: 18px;
	height: 18px;
	font-size: 14px;
	background-color: rgba(0, 0, 0, 0.2);
	border-width: 0;
	border-radius: 4px;
	color: var(--block-text);
	-unity-text-align: middle-center;
	padding: 0;
	margin: 0;
}

.time-block-btn:hover {
	background-color: rgba(0, 0, 0, 0.5);
}

/* 상세 팝업 */
.detail-popup {
	position: absolute;
	background-color: var(--color-bg-surface);
	border-radius: 8px;
	width: 220px;
	padding: 15px;
	border-width: 1px;
	border-color: var(--color-border);
	/* 그림자를 직접 지원하지 않으므로 테두리/색상으로 흉내 */
}

.detail-title {
	color: var(--color-text-main);
	font-size: 14px;
	-unity-font-style: bold;
	margin-bottom: 5px;
	white-space: normal;
}

.detail-time {
	color: var(--color-text-sub);
	font-size: 12px;
	margin-bottom: 10px;
}

.detail-desc {
	color: var(--color-text-main);
	font-size: 12px;
	margin-bottom: 15px;
	white-space: normal;
}

.detail-btn {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 4px;
	border-width: 0;
	padding: 8px;
	-unity-font-style: bold;
	margin-bottom: 5px;
}

.detail-btn:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.detail-btn-close {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 4px;
	border-width: 0;
	padding: 8px;
	-unity-font-style: bold;
	font-size: 11px;
	margin-top: 5px;
	width: 100%;
	align-self: center;
}

.detail-btn-close:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

/* 편집 다이얼로그 오버레이 */
.edit-overlay {
	position: absolute;
	left: 0; top: 0; right: 0; bottom: 0;
	background-color: var(--color-overlay);
	align-items: center;
	justify-content: center;
}

.edit-dialog {
	width: 350px;
	background-color: var(--color-bg-surface);
	border-radius: 12px;
	border-width: 1px;
	border-color: var(--color-border);
	padding: 20px;
}

.edit-header-title {
	color: var(--color-text-main);
	font-size: 18px;
	-unity-font-style: bold;
	margin-bottom: 20px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	padding-bottom: 10px;
}

/* 편집 다이얼로그 입력 */
.edit-dialog .unity-text-field {
	margin-bottom: 10px;
}

.color-picker-row {
	flex-direction: row;
	flex-wrap: wrap; /* 색상이 많을 경우 줄바꿈 허용 */
	justify-content: flex-start;
	margin-top: 5px;
	margin-bottom: 20px;
}

.color-select-btn {
	width: 24px;
	height: 24px;
	border-radius: 12px; /* 원형 */
	border-width: 2px;
	border-color: transparent;
	margin: 3px;
}

.color-select-btn:hover {
	border-color: white;
	transform-origin: center;
	scale: 1.1; 
}

/* 동작 */
.edit-actions {
	flex-direction: row;
	margin-top: 10px;
}

.btn-primary {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 6px;
	padding: 8px 16px;
	border-width: 0;
	-unity-font-style: bold;
}

.btn-primary:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.btn-secondary {
	background-color: transparent;
	color: var(--color-text-sub);
	border-width: 0;
	margin-right: 10px;
}

.btn-secondary:hover {
	background-color: var(--color-bg-hover);
	color: var(--color-text-main);
}

.btn-danger {
	background-color: rgba(239, 68, 68, 0.2);
	color: rgb(248, 113, 113);
	border-width: 1px;
	border-color: rgba(239, 68, 68, 0.5);
	border-radius: 6px;
	padding: 8px 12px;
}

.btn-danger:hover {
	background-color: rgb(239, 68, 68);
	color: white;
}

/* --- 도구 통합 --- */
.tool-header {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	padding-bottom: 15px;
	margin-bottom: 20px;
}

.tool-selector {
	width: 200px;
}

.tool-body {
	flex-grow: 1;
}

.input-group {
	margin-bottom: 15px;
}

.input-label {
	color: var(--color-text-sub);
	font-size: 12px;
	margin-bottom: 5px;
}

.tool-input-field > .unity-text-field__input {
	background-color: var(--color-bg-base); 
	border-color: var(--color-border); 
	color: var(--color-text-main);
	height: 80px;
	-unity-text-align: upper-left;
	border-radius: 4px;
}

.tool-input-field-single > .unity-text-field__input {
	background-color: var(--color-bg-base);
	border-color: var(--color-border);
	color: var(--color-text-main);
	border-radius: 4px;
}

.actions-grid {
	flex-direction: row;
	flex-wrap: wrap;
	margin-bottom: 20px;
}

.action-btn {
	width: 48%;
	margin-right: 2%;
	margin-bottom: 10px;
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	-unity-font-style: bold;
	padding: 10px;
	border-radius: 6px;
	border-width: 0;
}

.action-btn:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.action-btn-large {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	-unity-font-style: bold;
	border-radius: 6px;
	border-width: 0;
}

.action-btn-large:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.output-group {
	margin-top: 10px;
}

.output-field > .unity-text-field__input {
	background-color: var(--color-bg-base);
	border-color: var(--color-border);
	color: var(--color-text-main);
	height: 100px;
	-unity-text-align: upper-left;
}

.copy-btn {
	margin-top: 5px;
	align-self: flex-end;
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	width: 150px;
	border-radius: 4px;
	-unity-font-style: bold;
	border-width: 0;
}

.copy-btn:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

/* --- 마비노기 폰트 오버라이드 --- */
.header-title,
.header-icon,
.header-date,
.header-dday,
.tab-button,
.stat-title,
.stat-value,
.section-title,
.col-header,
.task-add-btn,
.action-btn,
.action-btn-large,
.secret-title,
.secret-btn,
.time-block-title,
.detail-title,
.detail-btn
{
	-unity-font: url('project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf');
	-unity-font-definition: initial;
	-unity-font-style: bold; /* 단일 폰트 파일을 사용하므로 합성 볼드체 사용 */
}


/* --- 크기 조절 핸들 --- */
#ResizeTop, #ResizeBottom {
	/* cursor: resize-vertical;  일부 유니티 버전에서 USS를 통해 지원됨 */
	background-color: transparent;
	border-color: rgba(255, 255, 255, 0);
	border-width: 0;
}

#ResizeTop:hover, #ResizeBottom:hover {
	background-color: rgba(255, 255, 255, 0.3);
}

.theme-light #ResizeTop:hover, .theme-light #ResizeBottom:hover {
	background-color: rgba(0, 0, 0, 0.2);
}

/* Global Tooltip System 냥! */
#GlobalTooltip {
    background-color: rgba(20, 20, 20, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
}

#GlobalTooltipLabel {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}
