@import url("ThemeTokens.uss");

/* =========================================================================================
   Global Container & Typography
   ========================================================================================= */

.planner-container {
	flex-grow: 1;
	background-color: var(--color-bg-base);
	padding: 15px;
	color: var(--color-text-main);
}

/* Force Font application */
.planner-container Label,
.planner-container Button,
.planner-container TextField,
.planner-container .unity-text-element {
	-unity-font: url("project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf");
	-unity-font-definition: initial;
}

/* =========================================================================================
   Unity Built-in Overrides (Global)
   ========================================================================================= */

/* Text Fields */
.unity-text-field,
.unity-base-text-field,
.unity-text-field__input {
	--unity-cursor-color: var(--unity-cursor-color);
}

.planner-container .unity-text-field__input {
	background-color: var(--color-bg-base);
	color: var(--color-text-main);
	border-color: var(--color-border);
	border-width: 1px;
	border-radius: 4px;
}

.unity-text-field__input:focus {
	border-color: var(--color-border-focus);
}

.unity-base-field__label {
	color: var(--color-text-sub); 
}

/* Integer/Double/Text fields background consistency */
.unity-integer-field .unity-integer-field__input,
.unity-double-field .unity-double-field__input,
.unity-text-field .unity-text-field__input {
	background-color: var(--color-bg-base); 
	color: var(--color-text-main);
	border-color: var(--color-border);
}

/* Dropdown / Enum Fields */
.planner-container .unity-base-popup-field__input {
	background-color: var(--color-bg-surface);
	color: var(--color-text-main);
	border-color: var(--color-border);
	border-width: 1px;
	border-radius: 4px;
}

.planner-container .unity-base-popup-field__text {
	color: var(--color-text-main);
}

.planner-container .unity-base-popup-field__arrow {
	-unity-background-image-tint-color: var(--color-text-main);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__input {
	background-color: var(--color-primary-hover);
	border-color: var(--color-primary-hover);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__text {
	color: var(--color-primary-text-hover);
}

.planner-container .unity-base-popup-field:hover .unity-base-popup-field__arrow {
	-unity-background-image-tint-color: var(--color-primary-text-hover);
}

/* Dropdown Popup Container */
.unity-base-dropdown__container-outer {
	background-color: var(--color-bg-surface);
	border-color: var(--color-border);
	border-width: 1px;
}

.unity-base-dropdown__item {
	background-color: var(--color-bg-surface);
}

.unity-base-dropdown__label {
	color: var(--color-text-main);
	-unity-font: url("project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf");
	-unity-font-definition: initial;
	font-size: 14px;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown__item:checked,
.unity-base-dropdown__item:selected {
	background-color: var(--color-bg-hover);
	color: var(--color-text-main);
}

/* Scrollers */
.unity-scroller__high-button,
.unity-scroller__low-button,
.unity-scroller__slider {
	background-color: var(--color-bg-base);
	border-color: var(--color-border);
}

.unity-scroller--horizontal {
	display: none; 
	height: 0;
}

.unity-base-slider__dragger {
	background-color: var(--color-border);
}

/* =========================================================================================
   Layout: Header & Navigation
   ========================================================================================= */

.top-header {
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding-bottom: 10px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	margin-bottom: 15px;
	flex-shrink: 0;
}

.header-left {
	flex-direction: row;
	align-items: center;
}

.header-icon {
	background-color: var(--color-primary); 
	padding: 8px;
	border-radius: 8px;
	margin-right: 12px;
	-unity-font-style: bold;
	color: var(--color-primary-text);
}

.header-title {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-text-main);
}

.header-subtitle {
	font-size: 12px;
	color: var(--color-text-sub);
}

.header-right {
	align-items: flex-end;
}

.theme-toggle-btn {
	width: 30px;
	height: 30px;
	background-color: transparent;
	color: var(--color-text-sub);
	border-width: 0;
	font-size: 20px;
	margin-bottom: 5px;
}
.theme-toggle-btn:hover {
	color: var(--color-text-main);
}

.header-subtitle-input > .unity-text-field__input {
	background-color: transparent;
	border-color: transparent;
	color: var(--color-text-sub);
	font-size: 14px;
	padding: 0;
	margin: 0;
}

.header-subtitle-input:hover > .unity-text-field__input {
	background-color: var(--color-bg-hover);
}

.header-date {
	font-size: 14px;
	-unity-font-style: bold;
	color: var(--color-text-sub);
}

.header-dday {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-primary); 
}

/* Tabs */
.nav-tabs {
	flex-direction: row;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	margin-bottom: 20px;
	flex-shrink: 0;
}

.tab-content {
	flex-grow: 1;
}

.tab-button {
	background-color: transparent;
	border-width: 0;
	color: var(--color-text-sub);
	padding: 10px 15px;
	-unity-font-style: bold;
	font-size: 14px;
	border-bottom-width: 2px;
	border-bottom-color: transparent;
	margin-right: 5px;
}

.tab-button:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
	border-radius: 4px 4px 0 0;
}

.tab-button.selected {
	color: var(--color-primary-text);
	background-color: var(--color-primary);
	border-bottom-color: var(--color-primary);
	border-radius: 4px 4px 0 0;
}

.tab-button.selected:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

/* =========================================================================================
   Universal Utilities
   ========================================================================================= */

.section-title {
	font-size: 16px;
	-unity-font-style: bold;
	color: var(--color-text-main);
	margin-bottom: 15px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	padding-bottom: 5px;
}

.tool-section {
	background-color: var(--color-bg-surface);
	padding: 15px;
	border-radius: 8px;
	border-width: 1px;
	border-color: var(--color-border);
	margin-bottom: 15px;
}

.input-label {
	color: var(--color-text-sub);
	font-size: 12px;
	margin-bottom: 5px;
}

/* Buttons */
.btn-primary {
	background-color: var(--color-primary);
	color: var(--color-primary-text);
	border-radius: 6px;
	padding: 8px 16px;
	border-width: 0;
	-unity-font-style: bold;
}

.btn-primary:hover {
	background-color: var(--color-primary-hover);
	color: var(--color-primary-text-hover);
}

.btn-secondary {
	background-color: transparent;
	color: var(--color-text-sub);
	border-width: 0;
	margin-right: 10px;
}

.btn-secondary:hover {
	background-color: var(--color-bg-hover);
	color: var(--color-text-main);
}

.btn-danger {
	background-color: rgba(239, 68, 68, 0.2);
	color: rgb(248, 113, 113);
	border-width: 1px;
	border-color: rgba(239, 68, 68, 0.5);
	border-radius: 6px;
	padding: 8px 12px;
}

.btn-danger:hover {
	background-color: rgb(239, 68, 68);
	color: white;
}

/* Resizing and Tooltips */
#ResizeTop, #ResizeBottom {
	background-color: transparent;
	border-color: rgba(255, 255, 255, 0);
	border-width: 0;
}

#ResizeTop:hover, #ResizeBottom:hover {
	background-color: rgba(255, 255, 255, 0.3);
}

.theme-light #ResizeTop:hover, .theme-light #ResizeBottom:hover {
	background-color: rgba(0, 0, 0, 0.2);
}

#GlobalTooltip {
    background-color: rgba(20, 20, 20, 0.95);
    border-color: rgba(255, 255, 255, 0.1);
    border-width: 1px;
    border-radius: 4px;
    padding: 6px 10px;
}

#GlobalTooltipLabel {
    color: white;
    font-size: 13px;
    -unity-font-style: bold;
    white-space: normal;
}

/* Font Assignments (Legacy) */
.header-title,
.header-icon,
.header-date,
.header-dday,
.tab-button,
.section-title
{
	-unity-font: url('project://database/Assets/Fonts/Mabinogi_Classic/OTF/Mabinogi_Classic_OTF.otf');
	-unity-font-definition: initial;
	-unity-font-style: bold; 
}
