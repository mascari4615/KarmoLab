/* CompanionSettingsView.uss */

.settings-panel {
    background-color: rgba(0, 0, 0, 0.9);
    padding: 10px;
    border-radius: 10px;
    position: absolute;
    width: 280px;
}

.header-row {
    flex-direction: row;
    margin-bottom: 10px;
    justify-content: space-between;
}

.tab-button {
    flex-grow: 1;
    background-color: rgb(51, 51, 51);
    color: white;
    border-width: 0;
    height: 30px;
    -unity-font-style: bold;
}

.tab-button:hover {
    background-color: rgb(76, 76, 76);
}

.tab-button:active {
    background-color: rgb(100, 100, 100);
}

/* Active tab style logic will be handled via class toggling in C# or just simple color change */
.tab-button.active {
    background-color: rgb(0, 120, 215);
}

.section-title {
    margin-top: 5px;
    -unity-font-style: bold;
    color: white;
}

.info-label {
    font-size: 12px;
    color: white;
}

.sub-label {
    font-size: 10px;
    color: gray;
}

.control-row {
    flex-direction: row;
    align-items: center;
}

.sw-container {
    margin-top: 10px;
    background-color: rgb(25, 25, 25);
    padding: 5px;
    border-radius: 5px;
}

.timer-display {
    color: white;
    font-size: 24px;
    -unity-font-style: bold;
    width: 100px;
}

.action-button {
    height: 30px;
    color: white;
}

.start-button {
    width: 60px;
    background-color: rgb(0, 128, 0);
}

.reset-button {
    width: 30px;
    margin-left: 5px;
    background-color: rgb(128, 0, 0);
}

.icon-button {
    width: 35px;
}

.pomo-settings {
    margin-top: 10px;
    padding-left: 5px;
    border-left-width: 2px;
    border-left-color: red;
}

.notify-section {
    margin-top: 15px;
    border-top-width: 1px;
    border-top-color: rgb(76, 76, 76);
    padding-top: 5px;
}

.settings-toggle {
    font-size: 10px;
    color: white;
}

.path-label {
    font-size: 10px;
    color: gray;
    white-space: nowrap;
    overflow: hidden;
    flex-grow: 1;
    margin-left: 5px;
}

.mini-button {
    font-size: 10px;
    height: 20px;
    margin-right: 2px;
}

/* =========================================================================================
   Standalone Components
   ========================================================================================= */

.btn-companion-settings {
    position: absolute;
    top: 20px;
    left: 20px;
    width: 40px;
    height: 40px;
    font-size: 30px;
    background-color: transparent;
    border-width: 0;
    color: white;
    -unity-text-align: middle-center;
    padding: 0;
    margin: 0;
    transition: scale 0.1s;
}

.btn-companion-settings:hover {
    scale: 1.2;
}
