<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
	<Style src="project://database/Assets/KarmoToys/Main/UI/MainStyle.uss"/>
	<Style src="project://database/Assets/KarmoToys/Features/Note/SecretNoteStyle.uss"/>
	<ui:ScrollView name="ViewSecret" class="tab-content" style="display: none;">
		<ui:VisualElement class="secret-header-box">
			<ui:Label text="Secret Guideline: 무엇을 얻을 것인가?" class="secret-title"/>
			<ui:Label text="- 구조 (Architecture): 코드가 아니라 논리를 가져와라." class="secret-desc"/>
			<ui:Label text="- 실패 (Troubleshooting): 버그의 원인과 해결 과정을 상세히 기록하라." class="secret-desc"/>
		</ui:VisualElement>
		<ui:VisualElement class="secret-form">
			<ui:TextField name="SecretProblem" label="Problem" placeholder-text="오늘 발견한 문제"/>
			<ui:TextField name="SecretWhy" label="Why" placeholder-text="근본적인 원인"/>
			<ui:TextField name="SecretSolution" label="Solution" placeholder-text="해결책 / 아이디어" multiline="true" style="height: 60px;"/>
			<ui:Button name="AddSecretBtn" text="비밀 노트에 기록하기" class="secret-btn"/>
		</ui:VisualElement>
		<ui:Label text="획득한 경험치 로그" class="section-title" style="margin-top: 20px;"/>
		<ui:VisualElement name="SecretList" class="secret-list"/>
	</ui:ScrollView>
</ui:UXML>
