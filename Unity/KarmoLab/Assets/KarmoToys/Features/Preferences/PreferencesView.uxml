<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
	<Style src="project://database/Assets/KarmoToys/Main/UI/MainStyle.uss"/>
	<Style src="project://database/Assets/KarmoToys/Features/Preferences/PreferencesStyle.uss"/>
	<ui:ScrollView name="ViewPreferences" class="tab-content preferences-container">
		<ui:Label text="Preferences ⚙️" class="section-title"/>
		
		<ui:VisualElement class="tool-section">
			<ui:Label text="Backup Settings" class="section-title"/>
			
			<ui:VisualElement class="backup-settings-row">
				<ui:Toggle name="AutoBackupToggle" text="저장 시 자동 백업 (Auto Backup on Save)" class="backup-settings-toggle"/>
			</ui:VisualElement>

			<ui:VisualElement class="backup-threshold-row">
				<ui:Label text="변경 감지 민감도 (Threshold):" class="backup-threshold-label"/>
				<ui:IntegerField name="ThresholdInput" value="10" class="backup-threshold-input"/>
				<ui:Label text="(items)" class="backup-threshold-unit"/>
			</ui:VisualElement>
			<ui:Label text="* 변경된 항목(할일, 블록 등) 수가 이 값 이상일 때만 백업합니다." class="backup-info-text"/>

			<ui:VisualElement class="backup-threshold-row">
				<ui:Label text="최대 백업 보관 수 (Max Backups):" class="backup-threshold-label"/>
				<ui:IntegerField name="MaxBackupCountInput" value="1000" class="backup-threshold-input"/>
			</ui:VisualElement>
		</ui:VisualElement>

		<ui:VisualElement class="tool-section">
			<ui:Label text="Data Management" class="section-title"/>
			<ui:VisualElement style="flex-direction: row; margin-bottom: 10px;">
				<ui:Button name="BtnOpenSaveDir" text="📂 Open Save Directory" class="btn-primary data-mgmt-btn" style="margin-right: 5px;"/>
				<ui:Button name="BtnRefreshData" text="🔄 Refresh Data" class="btn-primary data-mgmt-btn"/>
			</ui:VisualElement>
			
			<ui:Label text="Backup List &amp; Visual Diff" class="input-label"/>
			
			<ui:Label text="Diff Result:" class="input-label"/>
			<ui:Label name="BackupDiffResult" text="Select a backup to compare..." class="diff-result-box" style="margin-bottom: 10px;"/>
			
			<ui:ScrollView name="BackupFileList" class="backup-list-container"/>
		</ui:VisualElement>

		<ui:VisualElement class="danger-zone">
			<ui:Label text="Danger Zone ☠️" class="danger-title"/>
			<ui:Button name="BtnResetData" text="💣 Reset All Data" class="btn-danger"/>
			<ui:Label text="* 모든 데이터가 초기화됩니다. 신중하게 결정하세요." class="danger-text-small"/>
		</ui:VisualElement>
	</ui:ScrollView>

	<!-- Confirmation Popup Overlay -->
	<ui:VisualElement name="ConfirmationOverlay" class="edit-overlay" style="display: none;">
		<ui:VisualElement class="edit-dialog confirm-dialog">
			<ui:Label text="정말 삭제하시겠습니까?" class="edit-header-title confirm-header"/>
			<ui:Label name="ConfirmMessage" text="이 작업은 되돌릴 수 없습니다." class="confirm-message"/>
			<ui:VisualElement class="edit-actions confirm-actions">
				<ui:Button name="BtnConfirmCancel" text="취소" class="btn-secondary"/>
				<ui:Button name="BtnConfirmDelete" text="삭제" class="btn-danger" style="margin-left: 10px;"/>
			</ui:VisualElement>
		</ui:VisualElement>
	</ui:VisualElement>
</ui:UXML>
