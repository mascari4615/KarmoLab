/* Preferences Feature 전용 스타일 */

.preferences-container {
    flex-grow: 1;
    padding: 15px;
    display: none;
}

.backup-settings-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 15px;
}

.backup-threshold-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.backup-threshold-label {
    color: var(--color-text-sub);
    margin-right: 10px;
    width: 180px;
}

.backup-threshold-input {
    width: 80px;
}

.backup-threshold-unit {
    color: gray;
    margin-left: 5px;
}

.backup-info-text {
    color: gray;
    font-size: 10px;
    margin-bottom: 20px;
    margin-left: 5px;
}

.backup-settings-toggle {
    flex-grow: 1;
}

.data-mgmt-btn {
    flex-grow: 1;
}

.backup-list-container {
    height: 200px;
    background-color: var(--color-bg-base);
    border-radius: 4px;
    padding: 5px;
    margin-bottom: 10px;
    border-width: 1px;
    border-color: var(--color-border);
}

.diff-result-box {
    white-space: normal;
    color: var(--color-text-sub);
    min-height: 40px;
    padding: 10px;
    background-color: var(--color-bg-base);
    border-radius: 4px;
    border-width: 1px;
    border-color: var(--color-border);
}

.danger-zone {
    margin-top: 30px;
    border-top-width: 1px;
    border-color: var(--color-border);
    padding-top: 20px;
}

.danger-title {
    color: #ef4444;
    font-size: 14px;
    -unity-font-style: bold;
    margin-bottom: 10px;
}

/* 백업 리스트 아이템 */
.backup-item {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    margin-bottom: 4px;
    background-color: var(--color-bg-surface);
    border-radius: 4px;
    border-width: 1px;
    border-color: transparent;
    transition-property: background-color, border-color;
    transition-duration: 0.2s;
}

.backup-item:hover {
    background-color: var(--color-bg-hover);
    border-color: var(--color-border);
}

.backup-item-label {
    flex-grow: 1;
    color: var(--color-text-main);
    font-size: 13px;
}

/* Edit / Confirmation Popups */
.edit-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.5);
    align-items: center;
    justify-content: center;
}

.edit-dialog {
    background-color: var(--color-bg-surface);
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 20px;
}

.confirm-dialog {
    width: 300px;
}

.edit-header-title {
    color: var(--color-text-main);
    -unity-font-style: bold;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    padding-bottom: 10px;
}

.confirm-header {
    font-size: 16px; 
    margin-bottom: 20px;
}

.confirm-message {
    color: var(--color-text-sub); 
    margin-bottom: 30px; 
    white-space: normal;
}

.edit-actions {
    flex-direction: row;
    margin-top: 10px;
}

.confirm-actions {
    justify-content: flex-end;
}

.danger-text-small {
    color: rgb(180, 80, 80); 
    font-size: 10px; 
    margin-top: 5px;
}
