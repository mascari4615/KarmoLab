/* --- 퀘스트 보드 (할 일) --- */
.task-columns {
	flex-direction: row;
	height: 600px;
}

.task-column {
	flex-grow: 1;
	width: 33%;
	background-color: var(--color-bg-surface);
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 8px;
	margin-right: 15px;
	display: flex;
	flex-direction: column;
}

.col-header {
	padding: 15px;
	border-bottom-width: 1px;
	border-bottom-color: var(--color-border);
	-unity-font-style: bold;
	font-size: 14px;
}

.text-purple { color: var(--color-text-main); background-color: transparent; }
.text-blue { color: var(--color-text-main); background-color: transparent; }
.text-green { color: var(--color-text-main); background-color: transparent; }

.task-list-scroll {
	flex-grow: 1;
	padding: 10px;
}

.col-footer {
	padding: 10px;
	border-top-width: 1px;
	border-top-color: var(--color-border);
	flex-direction: row;
}

.task-input {
	flex-grow: 1;
	margin-right: 5px;
}

.task-add-btn {
	width: 30px;
	background-color: var(--color-bg-hover);
	color: var(--color-text-hover);
	-unity-font-style: bold;
	border-width: 0;
}

.task-add-btn:hover {
	background-color: var(--color-text-main);
	color: var(--color-bg-base);
}

.todo-item {
	flex-direction: row;
	padding: 8px;
	border-radius: 4px;
	margin-bottom: 5px;
	background-color: transparent;
}

.todo-item:hover {
	background-color: var(--color-bg-hover);
}

.todo-toggle {
	width: 16px;
	height: 16px;
	border-width: 1px;
	border-color: var(--color-border);
	border-radius: 4px;
	margin-right: 8px;
	margin-top: 2px;
	background-color: transparent;
}

.todo-toggle.completed {
	background-color: var(--color-text-main);
	border-color: var(--color-text-main);
}

.todo-content {
	flex-grow: 1;
	font-size: 14px;
	color: var(--color-text-main);
	white-space: normal;
}

.todo-content.completed {
	color: var(--color-text-sub);
	opacity: 0.6;
}

.todo-delete {
	color: var(--color-text-sub);
	background-color: transparent;
	border-width: 0;
	width: 20px;
	opacity: 0;
}

.todo-item:hover .todo-delete {
	opacity: 1;
}
