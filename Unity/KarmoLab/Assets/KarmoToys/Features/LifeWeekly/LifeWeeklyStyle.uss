
.life-weekly-scroll {
	flex-grow: 1;
	background-color: var(--color-bg-surface);
	border-radius: 8px;
	padding: 10px;
}

.life-weekly-title {
	font-size: 18px;
	-unity-font-style: bold;
	color: var(--color-text-main);
}

.life-weekly-grid-container {
	min-width: 100%;
	align-items: center;
	justify-content: center;
	padding: 40px;
}

.life-weekly-grid {
	flex-direction: row;
	flex-wrap: wrap;
	justify-content: flex-start;
	align-content: flex-start;
	/* 10px(block) + 4px(margin) = 14px / 14px * 52 = 728px */
	/* 이제 코드에서 WeeksPerRow에 따라 가변적으로 조절 */
	transform-origin: center;
}

.week-block {
	width: 10px;
	height: 10px;
	margin: 2px;
	border-width: 1px;
	border-radius: 2px;
	border-color: var(--color-border);
	transition-property: scale, border-color, border-width;
	transition-duration: 0.1s;
}

.week-block:hover {
	scale: 1.3;
	border-color: white;
	border-width: 1.5px;
}

.week-past {
	background-color: var(--color-text-sub);
	opacity: 0.3;
}

.week-current {
	background-color: var(--color-primary-hover);
	border-color: var(--color-primary-text);
	border-width: 2px;
}

.week-future {
	background-color: transparent;
	border-color: var(--color-border);
}

.week-marker-ten {
	border-color: var(--color-text-main);
	border-width: 1.5px;
}

.week-marker-one {
	border-color: var(--color-text-sub);
	border-width: 1.2px;
}

.week-marker-calendar {
	background-color: rgba(255, 255, 255, 0.1);
	border-color: var(--color-primary-text);
	border-width: 1px;
}

/* 지나온 블록에서도 강조가 잘 보이도록 투명도 조정 */
.week-past.week-marker-ten,
.week-past.week-marker-one,
.week-past.week-marker-calendar {
	opacity: 0.7;
}

.week-milestone {
	background-color: var(--block-color-0);
	border-color: white;
}
