/* Kanban View Styles */
.kanban-column {
    flex: 1;
    margin: 0 5px;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 8px;
    padding: 10px;
}

.column-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--color-text-main);
    margin-bottom: 10px;
    -unity-text-align: middle-center;
}

.column-list {
    flex-grow: 1;
}

.kanban-item {
    background-color: var(--color-bg-surface);
    border-radius: 8px;
    padding: 10px 10px 10px 16px; /* Extra left padding for strip */
    margin-bottom: 8px;
    border-width: 1px;
    border-color: var(--color-border);
    overflow: hidden; /* For strip clipping */
    transition: 0.1s;
}

.kanban-item:hover {
    border-color: var(--color-primary);
    scale: 1.02; /* Subtle pop */
}

.kanban-item.dragging {
    opacity: 0.5;
    scale: 0.95;
    border-color: var(--color-primary);
}

/* Priority Strip */
.priority-strip {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 6px;
}

.strip-high { background-color: #f87171; }
.strip-medium { background-color: #fbbf24; }
.strip-low { background-color: #60a5fa; }

/* Tags */
.tags-container {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
}

.tag-chip {
    font-size: 10px;
    background-color: rgba(255, 255, 255, 0.1);
    color: var(--color-text-sub);
    padding: 2px 6px;
    border-radius: 4px;
    margin-right: 4px;
    margin-bottom: 2px;
}

.item-title {
    font-size: 13px;
    color: var(--color-text-main);
}

.item-meta {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 5px;
}

.badge {
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    color: white;
}

.badge-task { background-color: #3b82f6; }
.badge-secret { background-color: #ef4444; }
.badge-idea { background-color: #10b981; }

/* Quick Add Button */
.btn-quick-add {
    background-color: transparent;
    border-width: 0;
    color: #888;
    margin-top: 5px;
    padding: 5px;
    font-size: 12px;
    transition: 0.2s;
}
