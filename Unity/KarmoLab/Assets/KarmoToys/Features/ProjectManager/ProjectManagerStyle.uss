.view-container {
    flex-grow: 1;
}

/* Shared Styles are kept here */

/* Shared Styles are kept here */


/* Compact Toolbar */
.pm-toolbar {
    flex-direction: row;
    align-items: center;
    padding: 10px;
    background-color: var(--color-bg-surface);
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    min-height: 50px;
}

.pm-search {
    width: 200px;
    margin-right: 10px;
}

.view-switcher {
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    padding: 2px;
}

.btn-tab {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-sub);
    padding: 6px 12px;
    border-radius: 4px;
    transition: 0.2s;
    font-size: 12px;
}

.btn-tab:hover {
    color: var(--color-text-main);
}

.btn-tab.selected {
    background-color: var(--color-primary);
    color: white;
}
