/* Modal Styles */
.modal-overlay {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    width: 100%; height: 100%;  /* 명시적으로 전체 화면 차지 */
    background-color: rgba(0, 0, 0, 0.7);
    justify-content: center;
    align-items: center;
    padding: 20px;
    /* Flexbox 레이아웃에서 독립 */
    flex-grow: 0;
    flex-shrink: 0;
}

.modal-container {
    background-color: var(--color-bg-surface);
    width: 500px;
    max-height: 90%;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--color-border);
    padding: 20px;
    flex-shrink: 0;
}

.modal-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--color-border);
    flex-shrink: 0;
}

.modal-body {
    flex-grow: 1;
    overflow: scroll;
    max-height: 600px;
}

.modal-input {
    margin-bottom: 15px;
}

.content-editor {
    height: 150px;
    white-space: normal;
}

.modal-footer {
    flex-direction: row;
    margin-top: 20px;
    padding-top: 15px;
    border-top-width: 1px;
    border-top-color: var(--color-border);
}

.modal-input .unity-base-field__label {
    min-width: 80px;
}
