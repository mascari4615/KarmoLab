/* Whiteboard Style */

.whiteboard-container {
    flex-grow: 1;
    overflow: hidden; /* Clip content outside the view */
    background-color: var(--color-bg-base);
    flex-direction: column;
}

.whiteboard-canvas {
    width: 100000px; /* Virtual Infinite Size */
    height: 100000px;
    transform-origin: 0 0;
    /* Center the initial view roughly via Manipulator logic, not Layout */
    position: absolute;
    left: 0px;
    top: 0px;
}

.grid-background {
    width: 100%;
    height: 100%;
    /* Dot Grid Pattern */
    --dot-color: rgba(128, 128, 128, 0.2);
    --dot-size: 1px;
    --grid-size: 20px;
    
    /* radial-gradient is not fully supported in USS runtime. 
       For a proper grid, we should use a Tiled Image or Mesh generation. 
       Disabling for now to prevent import errors. */
    /* background-image: radial-gradient(circle, var(--dot-color) var(--dot-size), transparent var(--dot-size)); */
    /* background-size: var(--grid-size) var(--grid-size); */
}

.whiteboard-node {
    position: absolute;
    width: 200px;
    height: 150px;
    background-color: #2a2a2a;
    border-radius: 8px;
    border-width: 1px;
    border-color: #3f3f3f;
    padding: 0;
    overflow: hidden;
}

.whiteboard-node:hover {
    border-color: #555555;
}

.whiteboard-node--selected {
    border-color: #3b82f6; /* Blue highlight */
    border-width: 2px;
}

.node-header {
    height: 32px;
    background-color: #333333;
    border-bottom-width: 1px;
    border-bottom-color: #3f3f3f;
    padding-left: 10px;
    padding-right: 10px;
    justify-content: center;
}

.node-title {
    color: #e5e5e5;
    -unity-font-style: bold;
    font-size: 14px;
}

.node-body {
    flex-grow: 1;
    padding: 10px;
}

.node-content {
    color: #cccccc;
    font-size: 12px;
    white-space: normal;
}

.node-title-edit {
    font-size: 14px;
    -unity-font-style: bold;
    color: #e5e5e5;
    background-color: #444;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.node-content-edit {
    font-size: 12px;
    color: #cccccc;
    background-color: #333;
    border-width: 0;
    white-space: normal;
    flex-grow: 1;
}
