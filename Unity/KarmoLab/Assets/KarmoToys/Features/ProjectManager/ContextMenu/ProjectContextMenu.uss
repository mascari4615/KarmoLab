/* Context Menu */
.context-menu {
    background-color: var(--color-bg-surface);
    border-width: 1px;
    border-color: var(--color-border);
    border-radius: 6px;
    padding: 5px;
    min-width: 150px;
}

.ctx-btn {
    background-color: transparent;
    border-width: 0;
    color: var(--color-text-main);
    -unity-text-align: middle-left;
    padding: 6px 10px;
    margin: 0;
    border-radius: 4px;
}

.ctx-btn:hover {
    background-color: var(--color-bg-hover);
}

.ctx-btn.btn-danger {
    color: #f87171;
}
